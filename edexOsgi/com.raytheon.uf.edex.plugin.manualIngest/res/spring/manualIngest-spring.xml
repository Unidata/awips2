<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="fileChangedStrategy" class="com.raytheon.uf.edex.esb.camel.FileChangedExclusiveReadLockStrategy">
        <constructor-arg value="${manualIngest.minFileAge}" />
    </bean>
    
    <bean id="inProgressRepository" class="org.apache.camel.support.processor.idempotent.MemoryIdempotentRepository" factory-method="memoryIdempotentRepository">
        <constructor-arg value="${manualIngest.inProgressCacheSize}" />
    </bean>
    
    <bean id="clusteredManualProc" factory-bean="routeContextFactory" factory-method="createClustered">
        <constructor-arg>
            <bean class="com.raytheon.uf.edex.plugin.manualIngest.ClusteredManualProcRoutes">
                <constructor-arg name="manualIngestDropBoxPath" value="${manualIngest.dropBoxPath}" />
                <constructor-arg name="manualIngestDelay" value="${manualIngest.delay}" />
                <constructor-arg name="manualIngestMaxMessagesPerPoll" value="${manualIngest.maxMessagesPerPoll}" />
                <constructor-arg name="manualIngestVmQueueSize" value="${manualIngest.vmQueueSize}" />
                <constructor-arg name="manualIngestThreads" value="${manualIngest.threads}" />
            </bean>
        </constructor-arg>
    </bean>

</beans>
