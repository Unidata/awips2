<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="dataStoreRepacker" class="com.raytheon.uf.edex.maintenance.DataStoreRepacker">
        <!--  the compression to repack at, valid values are NONE or GZIP -->
        <constructor-arg value="GZIP" />
    </bean>
    
     <!-- Repack on Scheduled timer -->
    <bean id="maintenanceContext" factory-bean="routeContextFactory" factory-method="create">
        <constructor-arg>
            <bean class="com.raytheon.uf.edex.maintenance.MaintenanceContextRoutes" >
                <constructor-arg name="repackCron" value="${repack.cron}" />
            </bean>
        </constructor-arg>
    </bean>
</beans>
