<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="svrwxDecoder" class="com.raytheon.uf.edex.plugin.svrwx.SvrWxDecoder" depends-on="svrwxPluginRegistered">
        <constructor-arg ref="svrwxPluginName" />
    </bean>

    <bean id="svrwxDistRegistry" factory-bean="distributionSrv"
        factory-method="register">
        <constructor-arg ref="svrwxPluginName" />
        <constructor-arg value="jms-durable:queue:Ingest.svrwx" />
    </bean>

    <bean id="svrwx-camel" factory-bean="routeContextFactory" factory-method="create">
        <constructor-arg>
            <bean class="com.raytheon.uf.edex.plugin.svrwx.SvrWxCamelRoutes" />
        </constructor-arg>
    </bean>
</beans>