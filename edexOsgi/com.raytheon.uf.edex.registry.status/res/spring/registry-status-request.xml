<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="RegistryStatusHealthCheck"
        class="com.raytheon.uf.edex.registry.status.RegistryStatusHealthCheck">
        <constructor-arg>
            <bean
                class="com.raytheon.uf.common.registry.ebxml.ThriftRegistryHandler" />
        </constructor-arg>
    </bean>
    
    <bean id="Registry-Status-HealthCheck-context" factory-bean="routeContextFactory" factory-method="create">
        <constructor-arg>
            <bean class="com.raytheon.uf.edex.registry.status.RegistryStatusHealthCheckContextRoutes">
                <constructor-arg name="registryHealthcheckCron" value="${registry.healthCheck.cron}" />
            </bean>
        </constructor-arg>
    </bean>
</beans>