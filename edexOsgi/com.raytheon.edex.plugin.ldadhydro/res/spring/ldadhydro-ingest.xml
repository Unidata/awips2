<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="hydroDecoder" class="com.raytheon.edex.plugin.ldad.LdadDecoder">
        <constructor-arg value="com.raytheon.uf.common.dataplugin.ldadhydro.HydroLdadRecord" />
        <constructor-arg value="hydro" />
    </bean>

    <bean id="hydroDatabase" class="java.lang.String">
        <constructor-arg type="java.lang.String" value="metadata" />
    </bean>

    <bean id="ldadhydroDistRegistry" factory-bean="distributionSrv"
        factory-method="register">
        <constructor-arg value="ldadhydro" />
        <constructor-arg value="jms-durable:queue:Ingest.ldadhydro" />
    </bean>

    <bean id="ldadhydroPointData" class="com.raytheon.edex.plugin.ldadhydro.dao.LdadhydroPointDataTransform" 
        depends-on="ldadhydroRegistered"/>
    
    <bean id="ldadhydro-camel" factory-bean="routeContextFactory" factory-method="create">
        <constructor-arg>
            <bean class="com.raytheon.edex.plugin.ldadhydro.LdadhydroCamelRoutes" />
        </constructor-arg>
    </bean>
</beans>
