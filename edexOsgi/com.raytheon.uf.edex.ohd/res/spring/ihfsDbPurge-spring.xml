<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="ihfsDbPurge" class="com.raytheon.uf.edex.ohd.whfs.WhfsSrv">
        <constructor-arg>
            <value>run_db_purge</value>
        </constructor-arg>
    </bean>
    
    <bean id="ihfsDbPurge-context" factory-bean="routeContextFactory" factory-method="create">
        <constructor-arg>
            <bean class="com.raytheon.uf.edex.ohd.camel.IhfsDbPurgeContextRoutes" >
                  <constructor-arg name="ihfsdbpurgeCron" value="${ihfsdbpurge.cron}" />
            </bean>
        </constructor-arg>
    </bean>
</beans>