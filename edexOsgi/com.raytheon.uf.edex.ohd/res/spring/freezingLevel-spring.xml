<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans.xsd">


    <bean id="mpeRucFreezingLevel" class="com.raytheon.uf.edex.ohd.pproc.MpeRUCFreezingLevel" />

    <bean id="frzLvlProc-context" factory-bean="routeContextFactory" factory-method="create">
        <constructor-arg>
            <bean class="com.raytheon.uf.edex.ohd.camel.FrzLvlProcContextRoutes" >
                 <constructor-arg name="floodarchiverCron" value="${freezingLevel.cron}" />
            </bean>
        </constructor-arg>
    </bean>
</beans>