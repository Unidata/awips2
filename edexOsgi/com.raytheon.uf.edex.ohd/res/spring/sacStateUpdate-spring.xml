<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="sacStateUpdate" class="com.raytheon.uf.edex.ohd.whfs.WhfsSrv">
        <constructor-arg>
            <value>run_SSHP_SAC_state_update</value>
        </constructor-arg>
    </bean>

    <bean id="sacStateUpdate-context" factory-bean="routeContextFactory" factory-method="create">
        <constructor-arg>
            <bean class="com.raytheon.uf.edex.ohd.camel.SacStateUpdateContextRoutes" >
                 <constructor-arg name="sacstateupdateCron" value="${sacstateupdate.cron}" />
            </bean>
        </constructor-arg>
    </bean>
</beans>