<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="logFilePurger" class="com.raytheon.uf.edex.ohd.whfs.WhfsSrv">
        <constructor-arg>
            <value>purge_files</value>
        </constructor-arg>
    </bean>

    <bean id="logFilePurger-context" factory-bean="routeContextFactory" factory-method="create">
        <constructor-arg>
            <bean class="com.raytheon.uf.edex.ohd.camel.LogFilePurgerContextRoutes" >
                  <constructor-arg name="logfilepurgerCron" value="${logfilepurger.cron}" />
            </bean>
        </constructor-arg>
    </bean>
</beans>
