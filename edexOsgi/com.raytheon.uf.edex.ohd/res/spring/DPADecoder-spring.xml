<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="dpaRadarDecompressor" class="com.raytheon.edex.plugin.radar.RadarDecompressor"/>
    <bean id="dpaDecodeSrv" class="com.raytheon.uf.edex.ohd.pproc.DecodeDpaSrv" />

    <bean id="dpaDistRegistry" factory-bean="distributionSrv"
        factory-method="register">
        <constructor-arg value="dpa" />
        <constructor-arg value="jms-durable:queue:Ingest.dpa"/>
    </bean>

    <bean id="dpaRadarServerDistRegistry" factory-bean="radarserverDistributionSrv"
        factory-method="register">
        <constructor-arg value="dpa" />
        <constructor-arg value="jms-durable:queue:Ingest.dpa"/>
    </bean>

    <bean id="nonClusteredDPAroutes" factory-bean="routeContextFactory" factory-method="create">
        <constructor-arg>
            <bean class="com.raytheon.uf.edex.ohd.camel.NonClusteredDPARoutes" />
        </constructor-arg>
    </bean>

    <bean id="clusteredDPAroutes" factory-bean="routeContextFactory" factory-method="createClustered">
        <constructor-arg>
            <bean class="com.raytheon.uf.edex.ohd.camel.ClusteredDpaRoutes" />
        </constructor-arg>
    </bean>
</beans>