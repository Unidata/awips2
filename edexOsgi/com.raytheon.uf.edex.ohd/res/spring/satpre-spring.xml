<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="satPreDataGenerator" class="com.raytheon.uf.edex.ohd.pproc.SatPreDataGenerator">
    </bean>
    
    <bean id="satPreDataGenerator-context" factory-bean="routeContextFactory" factory-method="createClustered">
        <constructor-arg>
            <bean class="com.raytheon.uf.edex.ohd.camel.SatPreDataGeneratorContextRoutes" >
                 <constructor-arg name="satPreDataGenerator" ref="satPreDataGenerator" />
            </bean>
        </constructor-arg>
    </bean>
</beans>