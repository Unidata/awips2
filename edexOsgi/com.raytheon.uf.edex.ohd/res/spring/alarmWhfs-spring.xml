<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="alarmSrv" class="com.raytheon.uf.edex.ohd.whfs.WhfsSrv">
        <constructor-arg>
            <value>run_alarm_whfs</value>
        </constructor-arg>
    </bean>

    <bean id="runReportAlarmSrv" class="com.raytheon.uf.edex.ohd.reportalarm.RunReportAlarmSrv" />

    <bean id="alarmWhfs-context" factory-bean="routeContextFactory" factory-method="create">
        <constructor-arg>
            <bean class="com.raytheon.uf.edex.ohd.camel.AlarmWhfsContextRoutes">
                 <constructor-arg name="alarmwhfsCron" value="${alarmwhfs.cron}" />
            </bean>
        </constructor-arg>
    </bean>
</beans>