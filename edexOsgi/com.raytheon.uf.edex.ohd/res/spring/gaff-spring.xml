<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="gaffService" class="com.raytheon.uf.edex.ohd.pproc.GAFF">
    </bean>

    <bean id="clustered-gaff-context" factory-bean="routeContextFactory" factory-method="createClustered">
        <constructor-arg>
            <bean class="com.raytheon.uf.edex.ohd.camel.ClusteredGaffContextRoutes" >
                 <constructor-arg name="gaffCron" value="${gaff.cron}" />
            </bean>
        </constructor-arg>
    </bean>
</beans>