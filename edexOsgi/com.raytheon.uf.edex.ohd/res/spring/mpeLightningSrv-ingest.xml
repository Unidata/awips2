<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="mpeLightSrv" class="com.raytheon.uf.edex.ohd.pproc.MpeLightningSrv" />

    <bean id="mpeLightSrv-context" factory-bean="routeContextFactory" factory-method="create">
        <constructor-arg>
            <bean class="com.raytheon.uf.edex.ohd.camel.MpeLightSrvContextRoutes" >
                <constructor-arg name="mpelightningsrvCron" value="${mpelightningsrv.cron}" />
            </bean>
        </constructor-arg>
    </bean>

</beans>
