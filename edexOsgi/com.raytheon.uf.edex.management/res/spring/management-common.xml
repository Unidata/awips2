<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="mgmtInit" class="com.raytheon.uf.edex.management.MgmtInitializer" />

    <bean id="statusHandler"
        class="com.raytheon.uf.edex.management.handler.diagnostic.StatusHandler" />

    <bean id="management" factory-bean="routeContextFactory" factory-method="create">
        <constructor-arg>
            <bean class="com.raytheon.uf.edex.management.ManagementRoutes">
                <constructor-arg name="mgmtPort" value="${MGMT_PORT}" />
            </bean>
        </constructor-arg>
    </bean>

</beans>
