<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans.xsd">
    
    <bean id="clusteredNdmProc" factory-bean="routeContextFactory" factory-method="createClustered">
        <constructor-arg>
            <bean class="com.raytheon.uf.edex.ndm.ClusteredNdmProcRoutes" >
                <constructor-arg name="edexHome" value="${edex.home}" />
            </bean>
        </constructor-arg>
    </bean>
</beans>
