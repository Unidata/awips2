<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="nucapsDecoder" class="com.raytheon.uf.edex.plugin.npp.sounding.NPPSoundingDecoder" depends-on="nucapsPluginRegistered">
        <constructor-arg ref="nucapsPluginName" />
    </bean>

    <bean id="nucapsDistRegistry" factory-bean="distributionSrv"
        factory-method="register">
        <constructor-arg ref="nucapsPluginName" />
        <constructor-arg value="jms-durable:queue:Ingest.nucaps" />
    </bean>

    <bean id="nucapsIngestRoute" factory-bean="routeContextFactory" factory-method="create">
        <constructor-arg>
            <bean class="com.raytheon.uf.edex.plugin.npp.nucaps.NucapsCamelRoutes" />
        </constructor-arg>
    </bean>
</beans>