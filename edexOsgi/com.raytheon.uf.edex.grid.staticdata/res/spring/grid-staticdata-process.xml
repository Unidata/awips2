<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="staticDataGenerator"
        class="com.raytheon.uf.edex.grid.staticdata.StaticDataGenerator"
        factory-method="getInstance" />
    
    <bean id="grid-staticdata-process" factory-bean="routeContextFactory" factory-method="create">
        <constructor-arg>
            <bean class="com.raytheon.uf.edex.grid.staticdata.GridStaticdataProcessRoutes" />
        </constructor-arg>
    </bean>
</beans>
